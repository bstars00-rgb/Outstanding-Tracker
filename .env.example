# ------------------------------------------------------------------
# Outstanding Receivables Tracker - automation environment (example)
# Copy to .env for local runs (dotenv is NOT auto-loaded; use `npx dotenv -e .env -- npm run report:weekly`
# or export the variables in your shell). NEVER commit real values. In GitHub, store the values marked
# [SECRET] as Actions Secrets and the others as Actions Variables.
# ------------------------------------------------------------------

# Component selection
DATA_SOURCE=mock            # mock | ellis
AI_PROVIDER=mock            # mock (rule-based) | claude
TEAMS_SENDER=mock           # mock | live
DRY_RUN=true                # true => never posts to Teams; writes preview files to automation/out/
TARGET_CHANNEL=test         # test | leaders (leaders only after DRY_RUN validation)
REPORT_DATE=                # optional YYYY-MM-DD override (default: latest Saturday in REPORT_TIMEZONE)
FORCE_RESEND=false          # bypass idempotency receipt
PUBLISH_DATA=false          # copy aggregated tracker-model.json/insight.json to public/data for the frontend live mode

# Reporting
REPORTING_CURRENCY=JPY      # ISO 4217; company default currency is JPY (Finance). Ellis base currency is KRW.
REPORT_LANGUAGE=ko          # ko | en - language of the Teams report wording (numbers unaffected)
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
TRACKER_BASE_URL=https://bstars00-rgb.github.io/Outstanding-Tracker/

# Recipients / storage (JSON)
RECIPIENT_CONFIG={"leaders_channel":"Leadership - Receivables","test_channel":"Outstanding Tracker - Test","admin_channel":"Ops Alerts","roles":["CEO","Finance Leader","GSM Leader","Sales Leaders","Collection Leader"]}
DATA_STORAGE_CONFIG={"dir":"automation/state"}

# [SECRET] Ellis MCP (Streamable HTTP JSON-RPC endpoint + Authorization header value, e.g. "Bearer xxx")
ELLIS_MCP_ENDPOINT=
ELLIS_MCP_AUTH=

# [SECRET] Microsoft Teams Workflows webhooks (one per channel)
TEAMS_WEBHOOK_URL=          # leaders channel
TEAMS_TEST_WEBHOOK_URL=     # test channel
TEAMS_ADMIN_WEBHOOK_URL=    # ops/admin alerts (falls back to test channel)

# [SECRET] AI provider key (Anthropic). ANTHROPIC_API_KEY is also accepted.
AI_API_KEY=

# Frontend build-time (public, non-secret)
VITE_DATA_MODE=mock         # mock | live
VITE_LIVE_DATA_URL=         # protected URL serving tracker-model.json + insight.json (default: <base>/data/)
VITE_BASE_PATH=/            # /<repo>/ for GitHub project pages
VITE_GATE_HASH=             # password gate: output of `npm run gate:hash -- "<password>"`; empty = gate disabled (local dev)
